{
  "name": "fuel-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram-бот з порадами по харчуванню для тріатлетів на основі тренувань і відновлення (intervals.icu)",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "dotenv": "^18.0.10",
    "grammy": "^1.46.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
